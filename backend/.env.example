APP_ENV=dev

AUTH_ENABLED=false
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123456
# AUTH_SECRET=
AUTH_TOKEN_EXPIRE_HOURS=12

LLM_MODEL=deepseek-chat
# LLM_API_KEY=
LLM_BASE_URL=https://api.agicto.cn/v1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_USERNAME=admin
MONGODB_PASSWORD=password123
MONGODB_DATABASE=spec_agent

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=password123
RABBITMQ_VHOST=/
CELERY_TASK_QUEUE=spec_agent

NMR_SERVER_BASE_URL=http://127.0.0.1:8080
LCMS_INFER_URL=http://127.0.0.1:9999/infer
RAMAN_CAPTURE_INSTRUMENT_IP=47.113.220.254
RAMAN_CAPTURE_CALLBACK_URL=http://127.0.0.1:8099/raman/jy/callback
RAMAN_CAPTURE_SUBMIT_PORT=7001
RAMAN_CAPTURE_RESULT_PORT=7002

SPEC_AGENT_RUNTIME_ROOT=.runtime
SPEC_AGENT_UPLOAD_ROOT=.runtime/uploads
SPEC_AGENT_OUTPUT_ROOT=.runtime/outputs
SPEC_AGENT_LOG_ROOT=.runtime/logs

SPECTRUM_FILES_ROOT=/data/spectrum_files

LCMS_MSCONVERT_MODE=auto
# Windows 示例: C:/Program Files/ProteoWizard/ProteoWizard 3.0.xxxxx/msconvert.exe
# LCMS_MSCONVERT_PATH=
LCMS_MSCONVERT_DOCKER_BIN=docker
LCMS_MSCONVERT_DOCKER_IMAGE=proteowizard/pwiz-skyline-i-agree-to-the-vendor-licenses
# LCMS_MSCONVERT_SHARED_ROOT=/tmp/spec-agent-lcms-convert
